---
import type { ProjectItem } from '../data/portfolio';
import ProjectDetails from './ProjectDetails.astro';
import { t, type Lang } from '../lib/i18n';

interface Props {
  projects: readonly ProjectItem[];
  lang: Lang;
}

const { projects, lang } = Astro.props;
const closeLabel = { es: 'cerrar()', en: 'close()' };
---

{projects.map((project) => (
  <template data-project-template={project.id}>
    <ProjectDetails project={project} lang={lang} />
  </template>
))}

<dialog id="project-modal" aria-labelledby="modal-title" class="w-[min(760px,95vw)] overflow-hidden rounded-xl border border-ide-border bg-ide-panel p-0 text-ide-text shadow-panel">
  <div class="border-b border-ide-border bg-ide-panel-soft px-4 py-2 text-xs text-ide-textMuted">project_modal.tsx</div>
  <div class="space-y-4 p-5 max-h-[80vh] overflow-auto scrollbar-thin">
    <div id="project-modal-content"></div>
    <div class="flex justify-end">
      <button id="close-project-modal" class="rounded-md border border-ide-border bg-ide-bg px-3 py-1.5 text-xs hover:border-ide-warn hover:text-ide-warn" type="button" data-i18n-es={closeLabel.es} data-i18n-en={closeLabel.en}>
        {t(closeLabel, lang)}
      </button>
    </div>
  </div>
</dialog>

<dialog id="diagram-modal" aria-labelledby="diagram-modal-title" class="w-[min(1100px,96vw)] max-h-[90vh] overflow-hidden rounded-xl border border-ide-border bg-ide-panel p-0 text-ide-text shadow-panel [&[open]]:flex [&[open]]:flex-col">
  <div class="border-b border-ide-border bg-ide-panel-soft px-4 py-2 text-xs text-ide-textMuted">diagram_view.tsx</div>
  <div class="diagram-modal-content space-y-4 p-5">
    <div class="flex flex-wrap items-center justify-between gap-3">
      <p id="diagram-modal-title" class="text-sm text-ide-textMuted"></p>
      <button id="close-diagram-modal" class="rounded-md border border-ide-border bg-ide-bg px-3 py-1.5 text-xs hover:border-ide-warn hover:text-ide-warn" type="button" data-i18n-es={closeLabel.es} data-i18n-en={closeLabel.en}>
        {t(closeLabel, lang)}
      </button>
    </div>
    <div id="diagram-modal-body" class="diagram-frame diagram-frame-scrollable"></div>
    <p id="diagram-modal-caption" class="text-[11px] uppercase tracking-[0.2em] text-ide-textMuted"></p>
  </div>
</dialog>

<script>
  const modal = document.querySelector<HTMLDialogElement>('#project-modal');
  const content = document.getElementById('project-modal-content');
  const diagramModal = document.querySelector<HTMLDialogElement>('#diagram-modal');
  const diagramBody = document.getElementById('diagram-modal-body');
  const diagramTitle = document.getElementById('diagram-modal-title');
  const diagramCaption = document.getElementById('diagram-modal-caption');

  const applyI18n = (root: ParentNode) => {
    const lang = document.documentElement.dataset.lang === 'en' ? 'en' : 'es';
    root.querySelectorAll<HTMLElement>('[data-i18n-es][data-i18n-en]').forEach((node) => {
      const value = lang === 'en' ? node.dataset.i18nEn : node.dataset.i18nEs;
      if (value === undefined) return;
      if (node.dataset.i18nAttr) node.setAttribute(node.dataset.i18nAttr, value);
      else node.textContent = value;
    });
  };

  const showDiagram = (root: ParentNode) => {
    root.querySelectorAll<HTMLElement>('[data-diagram-key]').forEach((diagram) => diagram.classList.remove('hidden'));
  };

  document.querySelectorAll<HTMLButtonElement>('.open-project-modal').forEach((button) => {
    button.addEventListener('click', () => {
      const template = Array.from(document.querySelectorAll<HTMLTemplateElement>('[data-project-template]'))
        .find((item) => item.dataset.projectTemplate === button.dataset.projectId);
      if (!template || !modal || !content) return;
      content.replaceChildren(template.content.cloneNode(true));
      showDiagram(content);
      applyI18n(content);
      modal.showModal();
      if (content.parentElement) content.parentElement.scrollTop = 0;
    });
  });

  content?.addEventListener('click', (event) => {
    if (!(event.target instanceof Element) || !event.target.closest('[data-expand-diagram]')) return;
    const source = content.querySelector('[data-project-diagram] [data-diagram-key]');
    if (!source || !diagramModal || !diagramBody) return;
    const clone = source.cloneNode(true);
    // Keep the existing diagram in the project modal without duplicating its IDs.
    if (clone instanceof HTMLElement) {
      clone.removeAttribute('id');
      clone.querySelectorAll('[id]').forEach((node) => node.removeAttribute('id'));
    }
    diagramBody.replaceChildren(clone);
    if (diagramTitle) diagramTitle.textContent = content.querySelector('#modal-title')?.textContent ?? '';
    if (diagramCaption) {
      const caption = content.querySelector<HTMLElement>('[data-diagram-caption]');
      diagramCaption.dataset.i18nEs = caption?.dataset.i18nEs ?? '';
      diagramCaption.dataset.i18nEn = caption?.dataset.i18nEn ?? '';
      diagramCaption.classList.toggle('hidden', !caption);
    }
    applyI18n(diagramModal);
    diagramModal.showModal();
  });

  document.getElementById('close-project-modal')?.addEventListener('click', () => modal?.close());
  document.getElementById('close-diagram-modal')?.addEventListener('click', () => diagramModal?.close());
  modal?.addEventListener('close', () => diagramModal?.close());

  for (const dialog of [modal, diagramModal]) {
    dialog?.addEventListener('click', (event) => {
      if (event.target !== dialog) return;
      const rect = dialog.getBoundingClientRect();
      if (event.clientX < rect.left || event.clientX > rect.right || event.clientY < rect.top || event.clientY > rect.bottom) dialog.close();
    });
  }
</script>
