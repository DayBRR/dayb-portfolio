---
import type { ProjectItem } from '../data/portfolio';
import { getStatusMeta } from '../data/projectStatus';
import { getFeaturedStack } from '../data/featuredStack';
import ProjectStack from './ProjectStack.astro';
import { t, type Lang } from '../lib/i18n';

interface Props {
  projects: readonly ProjectItem[];
  lang: Lang;
}

const { projects, lang } = Astro.props;

const sectionTitle = { es: 'Proyectos Destacados', en: 'Featured Projects' };
const sectionTagline = { es: 'Arquitectura antes que código.', en: 'Architecture before code.' };
const sectionCopy = {
  es: 'Haz click en cualquier parte de la tarjeta para abrir su modal con detalles y enlaces disponibles.',
  en: 'Click anywhere on a card to open the modal with details and available links.'
};
const inspectLabel = { es: 'click para inspeccionar', en: 'click to inspect' };

---

<section id="projects" class="animate-slideIn [animation-delay:120ms]">
  <div class="rounded-xl border border-ide-border bg-ide-panel/90 p-5">
    <h2
      class="text-xl font-semibold text-ide-text md:text-2xl"
      data-i18n-es="Proyectos Destacados"
      data-i18n-en="Featured Projects"
    >
      {t(sectionTitle, lang)}
    </h2>
    <p
      class="mt-1 text-xs uppercase tracking-[0.2em] text-ide-textMuted"
      data-i18n-es="Arquitectura antes que código."
      data-i18n-en="Architecture before code."
    >
      {t(sectionTagline, lang)}
    </p>
    <p
      class="mt-2 text-sm text-ide-textMuted"
      data-i18n-es="Haz click en cualquier parte de la tarjeta para abrir su modal con detalles y enlaces disponibles."
      data-i18n-en="Click anywhere on a card to open the modal with details and available links."
    >
      {t(sectionCopy, lang)}
    </p>
    <div class="mt-5 grid gap-4 md:grid-cols-2">
      {
        projects.map((project) => {
          const statusMeta = getStatusMeta(project.status);
          const statusEs = statusMeta.label.es;
          const statusEn = statusMeta.label.en;
          const statusLabel = t(statusMeta.label, lang);
          const statusStyle = `border-color:${statusMeta.color};color:${statusMeta.color};background:${statusMeta.bg};`;
          const hasStatus = statusLabel.length > 0;
          const ariaLabel = t(
            { es: `Abrir detalles del proyecto ${project.title}`, en: `Open project details for ${project.title}` },
            lang
          );
          return (
            <button
              type="button"
              class="project-card-trigger open-project-modal project-card w-full text-left focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ide-accent focus-visible:ring-offset-2 focus-visible:ring-offset-ide-panel"
              data-project-id={project.id}
              aria-label={ariaLabel}
              data-i18n-attr="aria-label"
              data-i18n-es={`Abrir detalles del proyecto ${project.title}`}
              data-i18n-en={`Open project details for ${project.title}`}
            >
              <div class="project-card-header">
                <p class="project-card-title text-ide-text">{project.title}</p>
                {
                  hasStatus ? (
                    <span
                      class="project-card-status inline-flex items-center gap-1.5 rounded-full border px-2.5 py-1 text-[10px] font-semibold uppercase tracking-[0.12em]"
                      style={statusStyle}
                    >
                      <span class="inline-flex h-3 w-3" set:html={statusMeta.icon}></span>
                      <span data-i18n-es={statusEs} data-i18n-en={statusEn}>
                        {statusLabel}
                      </span>
                    </span>
                  ) : null
                }
              </div>
              <p class="project-card-summary text-sm text-ide-textMuted" data-i18n-es={project.summary.es} data-i18n-en={project.summary.en}>
                {t(project.summary, lang)}
              </p>
              {project.type && <p class="mt-2 text-xs text-ide-accent" data-i18n-es={project.type.es} data-i18n-en={project.type.en}>{t(project.type, lang)}</p>}
              <div class="project-card-stack">
                <ProjectStack groups={getFeaturedStack(project)} lang={lang} />
              </div>
              <p class="project-card-action text-[11px] uppercase tracking-[0.14em] text-ide-accent">
                <span data-i18n-es="click para inspeccionar" data-i18n-en="click to inspect">
                {t(inspectLabel, lang)}
                </span>
                <svg class="project-card-arrow" aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
              </p>
            </button>
          );
        })
      }
    </div>
  </div>
</section>

<style>
  .project-card {
    position: relative;
    display: flex;
    flex-direction: column;
    min-width: 0;
    padding: clamp(1.125rem, 2.5vw, 1.5rem);
    border: 1px solid var(--ide-border);
    border-radius: 14px;
    background: linear-gradient(145deg, var(--ide-panel-soft), var(--ide-bg));
    box-shadow: 0 2px 6px rgb(0 0 0 / 6%);
    cursor: pointer;
    transition: border-color 180ms ease, box-shadow 180ms ease, transform 180ms ease;
  }

  .project-card-header {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .project-card-title {
    font-size: 1.25rem;
    font-weight: 600;
    line-height: 1.35;
    letter-spacing: -0.035em;
    overflow-wrap: anywhere;
  }

  .project-card-status {
    flex-shrink: 0;
    max-width: 100%;
  }

  .project-card-summary {
    margin-top: 1rem;
    line-height: 1.75;
  }

  .project-card-stack {
    margin-top: 1.25rem;
    margin-bottom: 1.5rem;
    padding-top: 1rem;
    border-top: 1px solid color-mix(in oklab, var(--ide-border), transparent 35%);
  }

  .project-card-action {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-top: auto;
    padding-top: 1rem;
    border-top: 1px solid color-mix(in oklab, var(--ide-border), transparent 35%);
  }

  .project-card-arrow {
    flex-shrink: 0;
    transition: transform 180ms ease;
  }

  .project-card:focus-visible {
    border-color: var(--ide-accent);
  }

  @media (hover: hover) {
    .project-card:hover {
      transform: translateY(-3px);
      border-color: var(--ide-accent);
      box-shadow: 0 8px 24px rgb(0 0 0 / 12%);
    }

    .project-card:hover .project-card-arrow {
      transform: translateX(3px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .project-card,
    .project-card-arrow {
      transition: none;
    }

    .project-card:hover,
    .project-card:hover .project-card-arrow {
      transform: none;
    }
  }
</style>
