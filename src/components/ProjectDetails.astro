---
import type { ProjectItem } from '../data/portfolio';
import { getStatusMeta } from '../data/projectStatus';
import { diagramConfigByKey } from '../data/diagrams';
import { t, type Lang } from '../lib/i18n';
import ProjectStack from './ProjectStack.astro';
import ConfigurableDiagram from './diagrams/ConfigurableDiagram.astro';

interface Props {
  project: ProjectItem;
  lang: Lang;
}

const { project, lang } = Astro.props;
const status = getStatusMeta(project.status);
const diagram = project.diagram ? diagramConfigByKey[project.diagram.key] : undefined;
const featuresLabel = { es: 'Funcionalidades destacadas', en: 'Key features' };
const linksLabel = { es: 'Enlaces del proyecto', en: 'Project links' };
---

<div class="space-y-4" data-project-detail={project.id}>
  <div>
    <div class="flex flex-wrap items-center gap-2">
      <h3 id="modal-title" class="text-2xl font-semibold">{project.title}</h3>
      <span class="inline-flex items-center gap-1.5 rounded-full border px-2.5 py-1 text-[10px] font-semibold uppercase tracking-[0.2em]" style={`border-color:${status.color};color:${status.color};background:${status.bg};`}>
        <span class="inline-flex h-3 w-3" set:html={status.icon}></span>
        <span data-i18n-es={status.label.es} data-i18n-en={status.label.en}>{t(status.label, lang)}</span>
      </span>
    </div>
    {project.type && <p class="mt-2 text-xs text-ide-accent" data-i18n-es={project.type.es} data-i18n-en={project.type.en}>{t(project.type, lang)}</p>}
    <p class="mt-2 text-sm text-ide-textMuted" data-i18n-es={project.summary.es} data-i18n-en={project.summary.en}>{t(project.summary, lang)}</p>
  </div>
  <p class="text-sm text-ide-text" data-i18n-es={project.description.es} data-i18n-en={project.description.en}>{t(project.description, lang)}</p>
  <ProjectStack groups={project.stack} lang={lang} />
  {!!project.features?.length && (
    <div>
      <h4 class="text-sm font-semibold text-ide-text" data-i18n-es={featuresLabel.es} data-i18n-en={featuresLabel.en}>{t(featuresLabel, lang)}</h4>
      <ul class="mt-2 list-disc space-y-2 pl-5 text-sm text-ide-textMuted">
        {project.features.map((feature) => <li data-i18n-es={feature.es} data-i18n-en={feature.en}>{t(feature, lang)}</li>)}
      </ul>
    </div>
  )}
  {!!project.links.length && (
    <div>
      <h4 class="mb-2 text-sm font-semibold" data-i18n-es={linksLabel.es} data-i18n-en={linksLabel.en}>{t(linksLabel, lang)}</h4>
      <div class="flex flex-wrap gap-2" data-project-links>
        {project.links.map((link) => (
          <a href={link.href} target="_blank" rel="noopener noreferrer" data-link-kind={link.kind} class="rounded-md border border-ide-border bg-ide-bg px-3 py-1.5 text-xs text-ide-text hover:border-ide-accent hover:text-ide-accent" data-i18n-es={link.label.es} data-i18n-en={link.label.en}>
            {t(link.label, lang)}
          </a>
        ))}
      </div>
    </div>
  )}
  {diagram && (
    <figure class="rounded-lg border border-ide-border bg-ide-bg/90 p-3">
      <div class="diagram-frame" data-project-diagram>
        <ConfigurableDiagram config={diagram} />
      </div>
      {project.diagram?.caption && <figcaption class="mt-2 text-[11px] text-ide-textMuted" data-diagram-caption data-i18n-es={project.diagram.caption.es} data-i18n-en={project.diagram.caption.en}>{t(project.diagram.caption, lang)}</figcaption>}
      <button type="button" data-expand-diagram class="mt-3 rounded-md border border-ide-border bg-ide-bg px-3 py-1.5 text-xs text-ide-text hover:border-ide-accent hover:text-ide-accent" data-i18n-es="expandir diagrama" data-i18n-en="expand diagram">
        {t({ es: 'expandir diagrama', en: 'expand diagram' }, lang)}
      </button>
    </figure>
  )}
</div>
